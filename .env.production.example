# ============================================
# TensorHub Community - Production Environment
# ============================================
# Copy this file to .env and fill in the values
#   cp .env.production.example .env

# ---- Application ----
TENSORHUB_APP_ENV=production
TENSORHUB_DEBUG=false

# ---- Database ----
TENSORHUB_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SECURE_DB_PASSWORD@db:5432/tensorhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_SECURE_DB_PASSWORD

# ---- Security ----
# IMPORTANT: Generate a random secret key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
TENSORHUB_JWT_SECRET_KEY=YOUR_RANDOM_SECRET_KEY_HERE
TENSORHUB_COOKIE_SECURE=true
TENSORHUB_COOKIE_DOMAIN=tensorhub.cn

# ---- CORS ----
TENSORHUB_CORS_ORIGINS=["https://tensorhub.cn","https://www.tensorhub.cn"]

# ---- Uploads ----
TENSORHUB_MAX_UPLOAD_SIZE_MB=5

# ---- Bootstrap Admin ----
TENSORHUB_BOOTSTRAP_ADMIN_USERNAME=admin
TENSORHUB_BOOTSTRAP_ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
TENSORHUB_BOOTSTRAP_ADMIN_REAL_NAME=TensorHub Admin
TENSORHUB_BOOTSTRAP_ADMIN_EMAIL=admin@tensorhub.cn
TENSORHUB_BOOTSTRAP_ADMIN_STUDENT_ID=ADMIN0001
TENSORHUB_BOOTSTRAP_ADMIN_MAJOR=System
TENSORHUB_BOOTSTRAP_ADMIN_GENDER=other